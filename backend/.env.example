# ---------------------------------------------------------------------------
# NAVKA Invoice Management API — environment variables
# Copy to backend/.env and fill in. Never commit the real .env file.
# Variables marked REQUIRED IN PRODUCTION stop the server if missing.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# REQUIRED IN PRODUCTION. MongoDB connection string (Atlas or self-hosted replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/navka_invoice_db

# REQUIRED IN PRODUCTION (min 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# REQUIRED IN PRODUCTION. Public URL of the frontend, e.g. https://invoices.navka.com
CORS_ORIGIN=http://localhost:5173

# Shopify Admin API (custom app with read_orders scope)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_admin_api_token
SHOPIFY_API_VERSION=2024-01
# Optional Shopify tuning
SHOPIFY_DEFAULT_HSN=UNMAPPED
SHOPIFY_MAX_RETRIES=4
SHOPIFY_RETRY_BASE_MS=1000

# Optional: time zone used to group report trends by day
REPORT_TIMEZONE=Asia/Kolkata

# Optional: built frontend served by the API in production (default ../frontend/dist).
# Set to an empty value to disable when the frontend is hosted elsewhere.
# FRONTEND_DIST=/srv/navka/frontend/dist

# Optional: set to 1 when running behind one reverse proxy (nginx, load balancer)
# so the login rate limit sees real client IPs.
TRUST_PROXY=

# Optional: failed-login throttling per IP + email
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15