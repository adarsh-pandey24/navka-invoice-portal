{
  "name": "navka-invoice-backend",
  "version": "1.0.0",
  "description": "NAVKA Invoice Management Web App Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:local": "tsx src/seed/localDb.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seedData.ts",
    "create-user": "tsx src/seed/createUser.ts",
    "create-user:prod": "node dist/seed/createUser.js",
    "test": "tsx src/test/modelsTest.ts && tsx src/test/authTest.ts && tsx src/test/dashboardTest.ts && tsx src/test/shopifyTest.ts && tsx src/test/shopifyLiveTest.ts && tsx src/test/invoiceTest.ts && tsx src/test/invoiceCreateTest.ts && tsx src/test/paymentTest.ts && tsx src/test/reportTest.ts && tsx src/test/rbacTest.ts && tsx src/test/e2eTest.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
